---
import StatusMark from './StatusMark.astro';
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <img class="site-footer__logo" src="/brand/puppet-logo-white.svg" alt="Puppet" width="90" height="27" />
      <p class="site-footer__wordmark">Stagehand</p>
      <p class="site-footer__note">Technical clarity for Puppet operations.</p>
      <p class="site-footer__brand-credit">A Perforce company</p>
    </div>
    <div class="site-footer__status">
      <span class="site-footer__label">SYSTEM</span>
      <StatusMark label="Documentation online" />
    </div>
  </div>
</footer>
