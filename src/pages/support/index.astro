---
import BaseLayout from '../../layouts/BaseLayout.astro';

const repositoryUrl = 'https://github.com/puppet-stagehand/stagehand-docs';
const issuesUrl = `${repositoryUrl}/issues`;
const newIssueUrl = `${issuesUrl}/new`;
---

<BaseLayout
  title="Support"
  description="Choose the correct public or commercial support path for Puppet Stagehand."
  canonicalPath="/support/"
>
  <header class="register-hero support-page__hero">
    <div class="container register-hero__grid">
      <div>
        <p class="register-hero__eyebrow">SUPPORT ROUTING / PUBLIC + COMMERCIAL</p>
        <h1>Stagehand support</h1>
      </div>
      <p class="register-hero__lede">
        Route documentation defects to the public project and customer product incidents through the
        commercial channel attached to your entitlement.
      </p>
    </div>
  </header>

  <section class="tier-intro" aria-labelledby="product-lifecycle-title">
    <div class="container">
      <p class="section-kicker">PRODUCT LIFECYCLE</p>
      <h2 id="product-lifecycle-title">Pre-1.0, actively developed.</h2>
      <p>
        Stagehand is in active pre-1.0 development. The current release is <strong>v0.2.3</strong>,
        and each Puppet or OpenVox environment support claim is added only after a maintainer
        verifies it — see the <a href="/compatibility/">compatibility register</a> for what is confirmed
        today.
      </p>
      <p class="support-page__warning">
        Premium PCP/orchestrator behavior is unavailable until an approved Stagehand release
        compatibility record documents it. Do not treat planned integration language as evidence
        that the behavior ships today.
      </p>
    </div>
  </section>

  <section class="support-page" aria-labelledby="support-paths-title">
    <div class="container">
      <div class="support-page__heading">
        <p class="section-kicker">CHOOSE A CHANNEL</p>
        <h2 id="support-paths-title">Two boundaries, kept explicit.</h2>
      </div>

      <div class="support-page__grid">
        <article>
          <p class="support-page__index">01 / PUBLIC PROJECT</p>
          <h3>Documentation and reproducible public defects</h3>
          <p>
            Use the Stagehand Docs issue tracker for non-sensitive documentation errors, broken
            public links, and reproducible defects that can be discussed in public.
          </p>
          <ul>
            <li><a href={repositoryUrl}>Browse the stagehand-docs repository</a></li>
            <li><a href={issuesUrl}>Review existing public issues</a></li>
            <li><a href={newIssueUrl}>Open a public issue</a></li>
          </ul>
          <p class="support-page__warning">
            Never include credentials, customer data, private diagnostics, or suspected
            vulnerabilities in a public issue.
          </p>
        </article>

        <article>
          <p class="support-page__index">02 / COMMERCIAL PRODUCT</p>
          <h3>Customer incidents and entitled assistance</h3>
          <p>
            For Puppet Core, Puppet Enterprise, PE Advanced, or a customer environment incident, use
            the private commercial support channel identified by your Puppet agreement or account
            contact. Include your entitlement and product versions there, after applying your
            organization's redaction policy.
          </p>
          <p>
            This public static site does not authenticate customers, determine entitlement, process
            Forge payments, or create commercial support cases.
          </p>
          <a href="/docs/security/">Review security and reporting guidance</a>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
