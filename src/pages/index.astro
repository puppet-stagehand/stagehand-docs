---
import BrandTriangles from '../components/BrandTriangles.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Puppet Stagehand"
  description="A focused interface for Puppet environment visibility, Bolt-native execution workflows, and explicit support boundaries."
  canonicalPath="/"
>
  <section class="control-hero" aria-labelledby="hero-title">
    <BrandTriangles class="control-hero__triangles" />
    <div class="container control-hero__grid">
      <div class="control-hero__intro">
        <p class="control-hero__eyebrow">PUPPET STAGEHAND</p>
        <h1 id="hero-title">Set the State. Pull the Strings.</h1>
        <p class="control-hero__lede">
          A focused interface for environment visibility, Bolt-native execution workflows, and
          clearly documented support boundaries.
        </p>
        <div class="control-hero__actions">
          <a class="btn btn-primary" href="/docs/getting-started/">Get started</a>
          <a class="btn btn-outline-light" href="/compatibility/">Check compatibility</a>
        </div>
      </div>
      <aside class="control-hero__rail" aria-label="Stagehand console preview">
        <figure class="control-hero__preview">
          <img
            src="/screenshots/action-center.jpg"
            alt="Stagehand's Action Center showing failed, corrective, and intentional node counts alongside service health, all running"
            width="1568"
            height="768"
          />
          <figcaption>Action Center — shown with synthetic demo data.</figcaption>
        </figure>
      </aside>
    </div>
  </section>
</BaseLayout>
