---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';

interface Props {
  entry: CollectionEntry<'docs'>;
  entries: CollectionEntry<'docs'>[];
  previous?: CollectionEntry<'docs'>;
  next?: CollectionEntry<'docs'>;
}

export async function getStaticPaths() {
  const allEntries = (await getCollection('docs')).sort(
    (left, right) => left.data.order - right.data.order,
  );
  // why-stagehand.md has no category (promoted to the top nav instead), so it's excluded from the
  // sidebar and from prev/next pagination; it still gets its own static page below.
  const navEntries = allEntries.filter((entry) => entry.data.category !== undefined);

  return allEntries.map((entry) => {
    const navIndex = navEntries.findIndex((navEntry) => navEntry.id === entry.id);
    return {
      params: { slug: entry.id },
      props: {
        entry,
        entries: navEntries,
        previous: navIndex >= 0 ? navEntries[navIndex - 1] : undefined,
        next: navIndex >= 0 ? navEntries[navIndex + 1] : undefined,
      },
    };
  });
}

const { entry, entries, previous, next } = Astro.props;
const { Content } = await render(entry);
---

<DocsLayout entry={entry} entries={entries} previous={previous} next={next}>
  <Content />
</DocsLayout>
