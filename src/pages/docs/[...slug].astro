---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';

interface Props {
  entry: CollectionEntry<'docs'>;
  entries: CollectionEntry<'docs'>[];
  previous?: CollectionEntry<'docs'>;
  next?: CollectionEntry<'docs'>;
}

export async function getStaticPaths() {
  const entries = (await getCollection('docs')).sort(
    (left, right) => left.data.order - right.data.order,
  );

  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      entries,
      previous: entries[index - 1],
      next: entries[index + 1],
    },
  }));
}

const { entry, entries, previous, next } = Astro.props;
const { Content } = await render(entry);
---

<DocsLayout entry={entry} entries={entries} previous={previous} next={next}>
  <Content />
</DocsLayout>
