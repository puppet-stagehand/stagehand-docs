{
  "name": "@puppet-stagehand/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest",
    "test:unit": "vitest run",
    "validate:data": "tsx scripts/validate-data.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "astro": "7.2.4",
    "bootstrap": "5.3.8",
    "sass": "1.103.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24.13.3",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-astro"
    ],
    "singleQuote": true,
    "printWidth": 100
  }
}
