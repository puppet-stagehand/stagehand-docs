aws_region = "us-east-2"

# S3 bucket names are global. Replace these organization-scoped examples before applying.
state_bucket_names = {
  testpilots = "puppet-stagehand-testpilots-tofu-state"
  beta       = "puppet-stagehand-beta-tofu-state"
  stable     = "puppet-stagehand-stable-tofu-state"
}

# Route 53 hosted zone that owns puppetstagehand.com. Replace with the real
# zone ID before applying.
hosted_zone_id = "Z0123456789ABCDEFGHIJ"
